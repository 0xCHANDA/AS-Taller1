using Bib_Hacienda.Eventos;
using Bib_Hacienda.Interfaces;
using Bib_Hacienda.Reglas;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading;
using System.Threading.Tasks;

namespace Bib_Hacienda.Clases
{
    public class Hacienda: IVacunacion, IVentaRes
    {
        //Atributos
        private List<Potrero> l_potreros;
        private List<Venta> l_ventas;
        private List<Usuario> l_usuarios;
        private List<Vacuna> l_vacunas;

        //Eventos
        private PublisherVacunacionCompletada publisher_vacunacion_completa = new PublisherVacunacionCompletada();
        private PublisherVacunaVencida publisher_vacuna_vencida = new PublisherVacunaVencida();

        //EventHandler
        internal void EventHandler() { }

        //Constructor vacío
        public Hacienda() 
        {
            l_potreros = new List<Potrero>();
            l_ventas = new List<Venta>();
            l_usuarios = new List<Usuario>();
            l_vacunas = new List<Vacuna>();
        }


        //Metodo para vender res
        public string vender_res(Potrero potrero, Res res, uint monto)
        {
            try
            {
                //Validar parámetros
                if (potrero == null) throw new ArgumentNullException(nameof(potrero));
                if (res == null) throw new ArgumentNullException(nameof(res));

                //Crear la venta
                Venta venta = new Venta(potrero, DateTime.Now, res, monto);
                //Agregar la venta a la lista de ventas
                l_ventas.Add(venta);
                //Remover la res del potrero
                l_potreros.Where(p => p == potrero).FirstOrDefault().L_reses.Remove(res);
                return $"Venta de la res {res.Nombre} realizada con exito";
            }
            catch (Exception er)
            {
                throw new Exception("Error inesperado en el metodo vender_res: " + er.Message);
            }

        }

        //Metodo para aplicar vacuna
        public string aplicar_vacuna(Vacuna vacuna, Res res)
        {
            try
            {
                //Validar parámetros
                if (vacuna == null) throw new ArgumentNullException(nameof(vacuna));
                if (res == null) throw new ArgumentNullException(nameof(res));

                //Contadores de vacunas aplicadas
                byte contador_bacterianas = 0;
                byte contador_vivas = 0;

                //Contar las vacunas ya aplicadas a la res
                foreach (Vacuna vac in res.L_vacunas_aplicadas)
                {
                    if (vac is Bacteriana)
                    {
                        contador_bacterianas++;
                    }
                    else if (vac is Viva)
                    {
                        contador_vivas++;
                    }
                }

                //Validar si se puede aplicar la vacuna segun el tipo de res y las reglas establecidas
                if (res is Ternero && (vacuna is Bacteriana && contador_bacterianas < ReglaVacuna.max_bac_ternero || vacuna is Viva && contador_vivas < ReglaVacuna.max_viv_ternero) ||
                    (res is Novillo && (vacuna is Bacteriana && contador_bacterianas < ReglaVacuna.max_bac_novillo || vacuna is Viva && contador_vivas < ReglaVacuna.max_viv_novillo)) ||
                    (res is Cebon && (vacuna is Bacteriana && contador_bacterianas < ReglaVacuna.max_bac_cebon || vacuna is Viva && contador_vivas < ReglaVacuna.max_viv_cebon)))
                {
                    //1 viva por 3 bacterianas -> ternero
                    //2 vivas por 2 bacterianas -> novillo
                    //4 vivas por 1 bacteriana -> cebon

                    //Validar período de aplicación si es vacuna bacteriana
                    if (vacuna is Bacteriana)
                    {
                        //Buscar la última vacuna bacteriana aplicada
                        Bacteriana ultimaBacteriana = res.L_vacunas_aplicadas
                            .OfType<Bacteriana>()
                            .OrderByDescending(v => v.Fecha_aplicacion)
                            .FirstOrDefault();

                        if (ultimaBacteriana != null)
                        {
                            //Calcular semanas transcurridas desde la última aplicación
                            TimeSpan tiempoTranscurrido = DateTime.Now - ultimaBacteriana.Fecha_aplicacion;
                            double semanasTranscurridas = tiempoTranscurrido.TotalDays / 7;

                            //Validar que hayan pasado las semanas necesarias según el período de la última vacuna
                            if (semanasTranscurridas < ultimaBacteriana.Periodo_aplicacion)
                            {
                                double semanasFaltantes = ultimaBacteriana.Periodo_aplicacion - semanasTranscurridas;
                                throw new Exception($"No se puede aplicar la vacuna bacteriana. Deben pasar {ultimaBacteriana.Periodo_aplicacion} semanas desde la última aplicación. Faltan {semanasFaltantes:F1} semanas.");
                            }
                        }
                    }

                    //Suscribirse al evento con una lambda para capturar el mensaje
                    string mensaje_vacuna = "";
                    publisher_vacuna_vencida.evt_vacuna_vencida += (mensaje) => {
                        mensaje_vacuna = mensaje;
                    };

                    //Validar fecha de vencimiento de la vacuna
                    bool vacuna_vencida = publisher_vacuna_vencida.Informar_Vacuna_Vencida(vacuna);

                    if (vacuna_vencida)
                    {
                        throw new Exception(mensaje_vacuna);
                    }
                    else
                    {
                        res.L_vacunas_aplicadas.Add(vacuna);
                        l_vacunas.Remove(vacuna);

                        //Actualizar contadores
                        if (vacuna is Bacteriana)
                        {
                            contador_bacterianas++;
                        }
                        else if (vacuna is Viva)
                        {
                            contador_vivas++;
                        }

                        //Suscribirse al evento de vacunación completada
                        string mensaje_vacunacion = "";
                        publisher_vacunacion_completa.evt_vacunacion_completada += (mensaje) => {
                            mensaje_vacunacion = mensaje;
                        };

                        //Disparar evento de vacunacion completa
                        bool esquema_completo = publisher_vacunacion_completa.Informar_Vacunacion_Completada(res, contador_bacterianas, contador_vivas);
  
                        return $"Vacuna aplicada correctamente a la res {res.Nombre}. {mensaje_vacunacion}";
                    }

                }
                else
                {
                    throw new Exception("El esquema de vacunación de la Res ya ha sido completado");
                }

            }
            catch (Exception err)
            {
                throw new Exception("Error inesperado en el metodo aplicar_vacuna: " + err.Message);
            }
        }
    }
}
