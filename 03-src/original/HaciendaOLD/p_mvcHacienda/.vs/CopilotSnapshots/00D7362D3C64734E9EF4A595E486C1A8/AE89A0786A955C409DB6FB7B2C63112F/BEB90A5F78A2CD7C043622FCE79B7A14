using Bib_Hacienda.Clases;
using p_mvcHacienda.Modelos;
using static Bib_Hacienda.Clases.Potrero;

namespace p_mvcHacienda.Servicios
{
    public class PotreroService
    {
        //Atributos
        private readonly Hacienda _hacienda;
        private readonly PersistenciaService _persistencia;

        //Constructor
        public PotreroService(Hacienda hacienda, PersistenciaService persistencia)
        {
            _hacienda = hacienda;
            _persistencia = persistencia;
        }

        // Crear un nuevo potrero
        public ResultadoOperacion CrearPotrero(string identificacion, l_tipos_potreros tipo)
        {
            try
            {
                string resultado = _hacienda.crear_potrero(identificacion, tipo);
                _persistencia.GuardarPotreros(_hacienda.L_potreros);
                _persistencia.GuardarReses(_hacienda.L_potreros);

                // Evaluar el resultado basado en el contenido del mensaje
                // Esto es temporal hasta que se pueda refactorizar la clase Hacienda
                if (resultado.Contains("✅") || resultado.ToLower().Contains("exitosamente") ||
                    resultado.ToLower().Contains("creado") || resultado.ToLower().Contains("éxito"))
                {
                    return ResultadoOperacion.Exito($"Potrero creado exitosamente: {identificacion}");
                }
                else
                {
                    return ResultadoOperacion.Error(resultado.Replace("❌", "").Trim());
                }
            }
            catch (Exception ex)
            {
                return ResultadoOperacion.Error($"Error al crear el potrero: {ex.Message}");
            }
        }

        // Obtener todos los potreros
        public List<Potrero> ObtenerTodosLosPotreros()
        {
            return _hacienda.L_potreros.OrderBy(p => p.Identificacion).ToList();
        }

        // Obtener un potrero por identificación
        public Potrero? ObtenerPotreroPorIdentificacion(string identificacion)
        {
            try
            {
                return _hacienda.buscar_potrero(identificacion);
            }
            catch
            {
                return null;
            }
        }

        // Agregar una res al potrero
        public ResultadoOperacion AgregarRes(string potreroId, string nombreRes, ushort edad, uint peso)
        {
            try
            {
                string resultado = _hacienda.anadir_res_potrero(potreroId, nombreRes, edad, peso);
                _persistencia.GuardarPotreros(_hacienda.L_potreros);
                _persistencia.GuardarReses(_hacienda.L_potreros);

                // Evaluar el resultado basado en el contenido del mensaje
                if (resultado.Contains("✅") || resultado.ToLower().Contains("exitosamente") ||
                    resultado.ToLower().Contains("agregada") || resultado.ToLower().Contains("añadida"))
                {
                    return ResultadoOperacion.Exito($"Res agregada exitosamente al potrero {potreroId}");
                }
                else
                {
                    return ResultadoOperacion.Error(resultado.Replace("❌", "").Trim());
                }
            }
            catch (Exception ex)
            {
                return ResultadoOperacion.Error($"Error al agregar la res: {ex.Message}");
            }
        }

        // Obtener estadísticas
        public Dictionary<string, object> ObtenerEstadisticas()
        {
            var potreros = _hacienda.L_potreros;
            return new Dictionary<string, object>
            {
                { "TotalPotreros", potreros.Count },
                { "TotalReses", potreros.Sum(p => p.L_reses.Count) },
                { "PotrerosVacios", potreros.Count(p => p.L_reses.Count == 0) },
                { "PotrerosConReses", potreros.Count(p => p.L_reses.Count > 0) }
            };
        }
    }
}
