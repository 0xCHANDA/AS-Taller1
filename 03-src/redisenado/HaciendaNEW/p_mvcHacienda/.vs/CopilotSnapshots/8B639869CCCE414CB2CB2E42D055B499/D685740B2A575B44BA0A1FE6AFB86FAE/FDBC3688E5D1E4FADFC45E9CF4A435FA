@model p_mvcHacienda.Models.Potrero

@{
    ViewData["Title"] = "Detalles del Potrero";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
      <!-- Encabezado -->
            <div class="text-center mb-4">
    <h1 class="display-5 fw-bold" style="color: #2e7d32;">
     🌿 Detalles del Potrero
            </h1>
          <p class="lead text-muted">Información completa del potrero @Model.Identificacion</p>
            </div>

      <!-- Tarjeta principal -->
            <div class="card shadow-lg" style="background-color: #fdf5e6; border: 2px solid #2e7d32;">
    <div class="card-header text-white text-center" style="background-color: #2e7d32;">
          <h3 class="mb-0">🏷️ @Model.Identificacion</h3>
    </div>
                <div class="card-body p-4">
         <div class="row">
    <!-- Información básica -->
             <div class="col-md-6 mb-4">
          <h5 class="border-bottom pb-2" style="color: #2e7d32;">📋 Información Básica</h5>
   <dl class="row">
           <dt class="col-sm-5">🆔 ID:</dt>
            <dd class="col-sm-7">@Model.Id</dd>
                    
         <dt class="col-sm-5">📦 Tipo:</dt>
             <dd class="col-sm-7">
          <span class="badge bg-secondary fs-6">@Model.Tipo</span>
 </dd>
   
        <dt class="col-sm-5">📅 Creado:</dt>
         <dd class="col-sm-7">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
      </dl>
        </div>

    <!-- Estadísticas de ocupación -->
     <div class="col-md-6 mb-4">
      <h5 class="border-bottom pb-2" style="color: #2e7d32;">📊 Ocupación</h5>
              <dl class="row">
  <dt class="col-sm-5">🐄 Reses actuales:</dt>
  <dd class="col-sm-7"><strong class="fs-4">@Model.CantidadReses</strong></dd>
        
        <dt class="col-sm-5">📊 Capacidad máxima:</dt>
        <dd class="col-sm-7"><strong class="fs-4">@Model.CapacidadMaxima</strong></dd>
         
        <dt class="col-sm-5">📈 Ocupación:</dt>
   <dd class="col-sm-7">
          <div class="progress" style="height: 30px;">
             <div class="progress-bar @(Model.EstaLleno ? "bg-danger" : Model.PorcentajeOcupacion > 75 ? "bg-warning" : "bg-success")" 
     role="progressbar" 
                  style="width: @Model.PorcentajeOcupacion%">
             <strong>@Model.PorcentajeOcupacion.ToString("F1")%</strong>
   </div>
       </div>
     </dd>
     
        <dt class="col-sm-5">🚦 Estado:</dt>
   <dd class="col-sm-7">
                 @if (Model.EstaLleno)
          {
     <span class="badge bg-danger fs-6">🚫 LLENO</span>
              }
   else if (Model.PorcentajeOcupacion > 75)
            {
    <span class="badge bg-warning fs-6">⚠️ CASI LLENO</span>
 }
              else if (Model.CantidadReses == 0)
       {
     <span class="badge bg-info fs-6">⭕ VACÍO</span>
   }
         else
       {
        <span class="badge bg-success fs-6">✅ DISPONIBLE</span>
     }
 </dd>
        </dl>
   </div>
               </div>

        <!-- Acciones rápidas -->
           <div class="row mt-4">
         <div class="col-12">
      <h5 class="border-bottom pb-2" style="color: #2e7d32;">⚙️ Acciones Rápidas</h5>
       <div class="d-flex gap-2 flex-wrap">
          @if (!Model.EstaLleno)
             {
            <form asp-controller="Potrero" asp-action="AgregarRes" asp-route-id="@Model.Id" method="post" class="d-inline">
         @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-success btn-lg rounded-pill px-4">
   ➕ Agregar Res 🐄
    </button>
             </form>
     }
          else
       {
   <button class="btn btn-secondary btn-lg rounded-pill px-4" disabled>
           🚫 Potrero Lleno
       </button>
     }

 @if (Model.CantidadReses > 0)
              {
<form asp-controller="Potrero" asp-action="RemoverRes" asp-route-id="@Model.Id" method="post" class="d-inline">
        @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-warning btn-lg rounded-pill px-4">
 ➖ Remover Res 🐄
 </button>
        </form>
     }
      </div>
            </div>
            </div>

      <!-- Botón volver -->
         <div class="mt-4 text-center">
         <a asp-action="Index" class="btn btn-secondary btn-lg rounded-pill px-5">
     ⬅️ Volver al Listado
         </a>
           </div>
  </div>
  </div>

            <!-- Información adicional -->
            <div class="row mt-4">
   <div class="col-md-6">
            <div class="card shadow-sm" style="background-color: #e8f5e9; border-left: 5px solid #4caf50;">
      <div class="card-body">
           <h5 class="card-title text-success">✅ Capacidad Disponible</h5>
        <p class="display-6 fw-bold">@(Model.CapacidadMaxima - Model.CantidadReses) reses</p>
        <small class="text-muted">Espacio disponible para nuevas reses</small>
        </div>
       </div>
           </div>
     <div class="col-md-6">
         <div class="card shadow-sm" style="background-color: #fff3e0; border-left: 5px solid #ff9800;">
   <div class="card-body">
       <h5 class="card-title text-warning">💡 Recomendación</h5>
  <p class="mb-2">
    @if (Model.EstaLleno)
      {
     <strong>El potrero está al máximo de su capacidad.</strong><br/>
          <small>Considera trasladar algunas reses o crear un nuevo potrero.</small>
       }
          else if (Model.PorcentajeOcupacion > 75)
               {
    <strong>El potrero está casi lleno.</strong><br/>
   <small>Planifica con anticipación la gestión de nuevas reses.</small>
         }
     else if (Model.CantidadReses == 0)
       {
          <strong>El potrero está vacío.</strong><br/>
      <small>Está listo para recibir reses de tipo @Model.Tipo.</small>
        }
           else
          {
    <strong>El potrero tiene buena disponibilidad.</strong><br/>
                <small>Puedes continuar agregando reses sin problema.</small>
   }
     </p>
   </div>
      </div>
          </div>
      </div>
        </div>
    </div>
</div>
