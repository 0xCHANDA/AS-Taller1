        #region Cargar Datos

        public List<Potrero> CargarPotreros()
 {
        try
            {
        string rutaArchivo = Path.Combine(_directorioArchivos, "Potreros.txt");

           if (!File.Exists(rutaArchivo) || new FileInfo(rutaArchivo).Length == 0)
          {
      return new List<Potrero>();
           }

    string json = File.ReadAllText(rutaArchivo);
     var datos = JsonSerializer.Deserialize<List<JsonElement>>(json);

    if (datos == null) return new List<Potrero>();

     var potreros = new List<Potrero>();

                foreach (var item in datos)
      {
         string identificacion = item.GetProperty("Identificacion").GetString() ?? "";
    string tipoStr = item.GetProperty("TipoPotrero").GetString() ?? "";

       l_tipos_potreros tipo = Enum.Parse<l_tipos_potreros>(tipoStr);
          var potrero = new Potrero(identificacion, tipo);

        // Cargar reses si existen
            if (item.TryGetProperty("Reses", out JsonElement resesElement))
   {
       foreach (var resItem in resesElement.EnumerateArray())
               {
    string nombreRes = resItem.GetProperty("Nombre").GetString() ?? "";
   uint pesoRes = resItem.GetProperty("Peso").GetUInt32();
      ushort edadRes = resItem.GetProperty("Edad").GetUInt16();

     // Agregar la res al potrero usando el método anadir_res
                potrero.anadir_res(nombreRes, edadRes, pesoRes);

   // Cargar vacunas aplicadas si existen
      if (resItem.TryGetProperty("Vacunas", out JsonElement vacunasElement))
    {
     var res = potrero.buscar_res(nombreRes);

            foreach (var vacItem in vacunasElement.EnumerateArray())
      {
              string nombreVac = vacItem.GetProperty("Nombre").GetString() ?? "";
       string loteVac = vacItem.GetProperty("Lote").GetString() ?? "";
       DateTime fechaVenc = vacItem.GetProperty("FechaVencimiento").GetDateTime();
            DateTime fechaAplic = vacItem.GetProperty("FechaAplicacion").GetDateTime();
           string tipoVac = vacItem.GetProperty("Tipo").GetString() ?? "";

        Vacuna vacuna;
         if (tipoVac == "Bacteriana")
     {
                uint periodo = vacItem.GetProperty("PeriodoAplicacion").GetUInt32();
          vacuna = new Bacteriana(nombreVac, loteVac, fechaVenc, fechaAplic, periodo);
}
       else
            {
      // Para Viva, usamos Atenuacion10 por defecto (no podemos acceder al valor original)
     vacuna = new Viva(nombreVac, loteVac, fechaVenc, fechaAplic, enum_l_atenuaciones.Atenuacion10);
       }

         res.L_vacunas_aplicadas.Add(vacuna);
   }
    }
  }
          }

 potreros.Add(potrero);
      }

    return potreros;
            }
            catch (Exception ex)
            {
     throw new Exception($"Error al cargar potreros: {ex.Message}");
      }
        }

        public List<Venta> CargarVentas(List<Potrero> potreros)
   {
       try
    {
          string rutaArchivo = Path.Combine(_directorioArchivos, "Ventas.txt");

       if (!File.Exists(rutaArchivo) || new FileInfo(rutaArchivo).Length == 0)
       {
  return new List<Venta>();
  }

      string json = File.ReadAllText(rutaArchivo);
    var datos = JsonSerializer.Deserialize<List<JsonElement>>(json);

           if (datos == null) return new List<Venta>();

   var ventas = new List<Venta>();

         foreach (var item in datos)
       {
         string potreroId = item.GetProperty("PotreroId").GetString() ?? "";
 DateTime fecha = item.GetProperty("Fecha").GetDateTime();
        string resNombre = item.GetProperty("ResNombre").GetString() ?? "";
      uint resPeso = item.GetProperty("ResPeso").GetUInt32();
             ushort resEdad = item.GetProperty("ResEdad").GetUInt16();
       string resTipo = item.GetProperty("ResTipo").GetString() ?? "";
              uint monto = item.GetProperty("Monto").GetUInt32();

        // Buscar o crear potrero
        var potrero = potreros.FirstOrDefault(p => p.Identificacion == potreroId);

  if (potrero == null)
          {
// Si no existe, crear un potrero temporal (las ventas son históricas)
      potrero = new Potrero(potreroId, l_tipos_potreros.ternero);
    }

// Crear res según el tipo
       Res res = resTipo switch
   {
         "Ternero" => new Ternero(resNombre, resPeso, resEdad),
 "Novillo" => new Novillo(resNombre, resPeso, resEdad),
         "Cebon" => new Cebon(resNombre, resPeso, resEdad),
           _ => new Ternero(resNombre, resPeso, resEdad)
               };

   var venta = new Venta(potrero, fecha, res, monto);
 ventas.Add(venta);
           }

       return ventas;
     }
            catch (Exception ex)
     {
      throw new Exception($"Error al cargar ventas: {ex.Message}");
       }
        }

 public List<Vacuna> CargarVacunas()
        {
try
            {
                string rutaArchivo = Path.Combine(_directorioArchivos, "Vacunas.txt");

  if (!File.Exists(rutaArchivo) || new FileInfo(rutaArchivo).Length == 0)
         {
            return new List<Vacuna>();
