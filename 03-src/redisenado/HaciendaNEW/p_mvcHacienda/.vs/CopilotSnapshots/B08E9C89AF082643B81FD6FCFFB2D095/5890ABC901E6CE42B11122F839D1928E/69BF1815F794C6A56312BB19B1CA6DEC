}
        }

   public List<Usuario> CargarUsuarios()
     {
 try
    {
         string rutaArchivo = Path.Combine(_directorioArchivos, "Usuarios.txt");

    if (!File.Exists(rutaArchivo) || new FileInfo(rutaArchivo).Length == 0)
     {
   return new List<Usuario>();
      }

    string json = File.ReadAllText(rutaArchivo);
     
 // Validar que el contenido parece JSON
   string jsonTrimmed = json.TrimStart();
   if (!jsonTrimmed.StartsWith("[") && !jsonTrimmed.StartsWith("{"))
   {
            // Archivo corrupto o con contenido inválido, reinicializar
      Console.WriteLine("⚠️ Archivo Usuarios.txt corrupto. Reinicializando...");
  File.WriteAllText(rutaArchivo, "[]");
            return new List<Usuario>();
  }
  
      var datos = JsonSerializer.Deserialize<List<JsonElement>>(json);

        if (datos == null) return new List<Usuario>();

    var usuarios = new List<Usuario>();

    foreach (var item in datos)
          {
     string nombre = item.GetProperty("Nombre").GetString() ?? "";
      string contrasena = item.GetProperty("Contrasena").GetString() ?? "";

usuarios.Add(new Usuario(nombre, contrasena));
      }

       return usuarios;
   }
     catch (System.Text.Json.JsonException)
      {
         // Si hay error de JSON, reinicializar el archivo y devolver lista vacía
       Console.WriteLine("⚠️ Error al deserializar Usuarios.txt. Reinicializando archivo...");
         string rutaArchivo = Path.Combine(_directorioArchivos, "Usuarios.txt");
    File.WriteAllText(rutaArchivo, "[]");
      return new List<Usuario>();
 }
      catch (Exception ex)
  {
  throw new Exception($"Error al cargar usuarios: {ex.Message}");
    }
   }

