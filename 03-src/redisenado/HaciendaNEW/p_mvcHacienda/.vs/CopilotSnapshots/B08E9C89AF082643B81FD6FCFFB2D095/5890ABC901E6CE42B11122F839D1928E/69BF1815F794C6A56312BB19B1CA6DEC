     #region Guardar Datos

        public void GuardarPotreros(List<Potrero> potreros)
   {
  try
            {
   var datos = potreros.Select(p => new
    {
   Identificacion = p.Identificacion,
        TipoPotrero = p.Tipo_potrero.ToString(),
     Reses = p.L_reses.Select(r => new
             {
Nombre = r.Nombre,
        Peso = r.Peso,
 Edad = r.Edad,
        Tipo = r.GetType().Name,
    Vacunas = r.L_vacunas_aplicadas.Select(v => new
          {
         Nombre = v.Nombre,
           Lote = v.Lote,
        FechaVencimiento = v.Fecha_vencimiento,
                FechaAplicacion = v.Fecha_aplicacion,
    Tipo = v.GetType().Name,
       // Solo guardamos periodo de bacteriana (viva no tiene accesor público)
   PeriodoAplicacion = v is Bacteriana ? ((Bacteriana)v).Periodo_aplicacion : 0
     }).ToList()
         }).ToList()
    }).ToList();

     string json = JsonSerializer.Serialize(datos, new JsonSerializerOptions { WriteIndented = true });
           File.WriteAllText(Path.Combine(_directorioArchivos, "Potreros.txt"), json);
   }
 catch (Exception ex)
          {
    throw new Exception($"Error al guardar potreros: {ex.Message}");
      }
        }

