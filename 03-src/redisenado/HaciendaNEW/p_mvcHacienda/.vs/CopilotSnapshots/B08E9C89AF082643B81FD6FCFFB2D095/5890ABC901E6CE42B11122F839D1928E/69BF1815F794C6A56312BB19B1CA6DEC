   DateTime fechaAplic = item.GetProperty("FechaAplicacion").GetDateTime();
                 string tipo = item.GetProperty("Tipo").GetString() ?? "";

           Vacuna vacuna;
            if (tipo == "Bacteriana")
         {
uint periodo = item.GetProperty("PeriodoAplicacion").GetUInt32();
                 vacuna = new Bacteriana(nombre, lote, fechaVenc, fechaAplic, periodo);
         }
        else
      {
       // Para Viva, usamos Atenuacion10 por defecto
        vacuna = new Viva(nombre, lote, fechaVenc, fechaAplic, enum_l_atenuaciones.Atenuacion10);
             }

      vacunas.Add(vacuna);
