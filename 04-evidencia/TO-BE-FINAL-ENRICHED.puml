@startuml
' ============================================================================
' Hacienda TO-BE FINAL — enriquecido con miembros implementados
' Fuente normativa. Reemplaza a los PNG aspiracionales de Fase 3.
' Corte: 2026-08-10
' Correspondencia 1:1 con código en 03-src/redisenado/HaciendaNEW
' ============================================================================

title Hacienda TO-BE final — arquitectura materializada (2026-08-10)

' --- Skinparam / colores / leyenda ---
skinparam packageStyle rectangle
skinparam backgroundColor #FAFAFA
skinparam defaultFontSize 11

' Leyenda visual (colores alineados con principios SOLID)
legend right
  |= Color |= Significado |
  |<#FFFFFF> Negro/blanco | Clase conservada del AS-IS |
  |<#E8F5E9> Verde (OCP) | Punto de extensión / nueva variante |
  |<#FFF3E0> Naranja (SRP) | Responsabilidad separada |
  |<#E3F2FD> Azul (ISP) | Interfaz segregada por cliente |
  |<#FCE4EC> Rosa (DIP) | Dependencia invertida / puerto |
  |<#F3E5F5> Violeta (LSP) | Jerarquía validada |
  |<#ECEFF1> Gris | Infraestructura / composition root |
  |<#FFFDE7> Amarillo | SC-1 variante nueva (Carne) |
endlegend

' ============================================================================
' PAQUETE: Dominio — Bib_Hacienda.Clases
' ============================================================================
package "Dominio — Bib_Hacienda.Clases" #FFFFFF {

  ' --- Jerarquía de productos (OCP + LSP) ---
  abstract class Producto #E8F5E9 {
    - nombre : string
    + Producto(nombre : string)
    + Nombre : string { get; set }
  }

  abstract class Res #F3E5F5 {
    - peso : uint
    - edad : ushort
    - l_vacunas_aplicadas : List<Vacuna>
    + Res(nombre : string, peso : uint, edad : ushort)
    + Edad : ushort { get }
    + Peso : uint { get; set }
    + L_vacunas_aplicadas : List<Vacuna> { get }
    + aplicar_vacuna(vacuna : Vacuna) : void
    + Alimentar(unidades : uint) : string
  }

  class Ternero #F3E5F5 {
    + Ternero(nombre : string, peso : uint, edad : ushort)
    ' valida edad 0-12
  }

  class Cebon #F3E5F5 {
    + Cebon(nombre : string, peso : uint, edad : ushort)
    ' valida edad 13-36
  }

  class Novillo #F3E5F5 {
    + Novillo(nombre : string, peso : uint, edad : ushort)
    ' valida edad 37-48
  }

  class Lacteo #E8F5E9 {
    + Lacteo(nombre : string)
  }

  class Carne #FFFDE7 <<SC-1 nuevo>> {
    + Carne(nombre : string)
  }

  class Piel #E8F5E9 {
    + Piel(nombre : string)
  }

  ' --- Vacunas ---
  abstract class Vacuna #FFFFFF {
    + Nombre : string
    + Lote : string
    + FechaFabricacion : DateTime
    + FechaVencimiento : DateTime
    + EstaVencida() : bool
    + {abstract} aplicar(res : Res) : string
  }

  class Bacteriana #FFFFFF {
    + aplicar(res : Res) : string
  }

  class Viva #FFFFFF {
    + aplicar(res : Res) : string
  }

  ' --- Inventarios (OCP + ISP) ---
  class Potrero #E8F5E9 {
    + enum l_tipos_potreros
    - identificacion : string
    - l_reses : List<Res>
    - tipo_potrero : l_tipos_potreros
    + Potrero(identificacion : string, tipo : l_tipos_potreros)
    + anadir_res(nombre : string, edad : ushort, peso : uint) : string
    + buscar_res(nombre : string) : Res
    + contiene(producto : Res) : bool
    + retirar(producto : Res) : Res
    + agregar(producto : Res) : void
  }

  class InventarioLacteos #E8F5E9 {
    - productos : List<Lacteo>
    + contiene(producto : Lacteo) : bool
    + retirar(producto : Lacteo) : Lacteo
    + agregar(producto : Lacteo) : void
  }

  class InventarioCarnes #FFFDE7 <<SC-1 nuevo>> {
    - productos : List<Carne>
    + contiene(producto : Carne) : bool
    + retirar(producto : Carne) : Carne
    + agregar(producto : Carne) : void
  }

  class InventarioPieles #E8F5E9 {
    - productos : List<Piel>
    + contiene(producto : Piel) : bool
    + retirar(producto : Piel) : Piel
    + agregar(producto : Piel) : void
  }

  ' --- Hacienda (SRP parcial con RegistroVenta) ---
  class Hacienda #FFF3E0 {
    - l_potreros : List<Potrero>
    - registroVentas : RegistroVenta
    - l_vacunas : List<Vacuna>
    + Hacienda()
    + crear_potrero(identificacion : string, tipo : l_tipos_potreros) : string
    + anadir_res_potrero(id_potrero : string, nombre : string, edad : ushort, peso : uint) : string
    + vender<T>(inventario : IInventarioVendible<T>, producto : T, monto : uint) : string
    + vender<T>(inventario : IInventario<T>, producto : T, monto : uint) : string
    + vender_res(id_potrero : string, nombre : string, monto : uint) : string
    + registrar_venta_cargada(venta : Venta) : void
    + crear_vacuna(tipo : TipoVacuna, nombre : string, lote : string, fFab : DateTime, fVen : DateTime) : string
    + aplicar_vacuna_hato(id_potrero : string, lote : string) : string
    + buscar_potrero(identificacion : string) : Potrero
    + L_potreros : List<Potrero> { get }
    + L_ventas : List<Venta> { get }
    + L_vacunas : List<Vacuna> { get }
  }

  class RegistroVenta #FFF3E0 {
    - ventas : List<Venta>
    + Ventas : IReadOnlyList<Venta> { get }
    + registrar(venta : Venta) : void
  }

  ' --- FabricadorVacunas (SRP: extraído desde Hacienda) ---
  class FabricadorVacunas #FFF3E0 {
    - l_vacunas : List<Vacuna>
    + FabricadorVacunas(l_vacunas : List<Vacuna>)
    + Crear(nombre : string, lote : string, fv : DateTime, fa : DateTime, periodo : uint) : string
    + Crear(nombre : string, lote : string, fv : DateTime, fa : DateTime, atenuacion : enum_l_atenuaciones) : string
    + CrearLote(nombre : string, lote_base : string, fv : DateTime, fa : DateTime, periodo : uint, cantidad : uint) : string
    + CrearLote(nombre : string, lote_base : string, fv : DateTime, fa : DateTime, atenuacion : enum_l_atenuaciones, cantidad : uint) : string
    + L_vacunas : List<Vacuna> { get }
  }

  ' --- Venta ---
  class Venta #FFFFFF {
    - fecha : DateTime
    - producto : Producto
    - monto : uint
    - potrero : Potrero
    - res : Res
    + Venta(fecha : DateTime, producto : Producto, monto : uint)
    + Venta(potrero : Potrero, fecha : DateTime, res : Res, monto : uint)
    + Fecha : DateTime { get; set }
    + Producto : Producto { get; set }
    + Monto : uint { get; set }
    + Potrero : Potrero { get; set }
    + Res : Res { get; set }
  }

  ' --- Usuario / Auth ---
  class Usuario #FFFFFF
  class Autenticacion #FFFFFF
}

' ============================================================================
' PAQUETE: Contratos — Bib_Hacienda.Interfaces
' ============================================================================
package "Contratos — Bib_Hacienda.Interfaces" #E3F2FD {

  interface IInventarioVendible #E3F2FD {
    + contiene(producto : T) : bool
    + retirar(producto : T) : T
    ' <T : Producto>
  }

  interface IInventario #E3F2FD {
    + agregar(producto : T) : void
    ' extiende IInventarioVendible<T>
  }

  interface IVentaRes #E3F2FD
  interface IVacunacion #E3F2FD
  interface ICreacionVacuna #E3F2FD
  interface IAutenticacion #E3F2FD

  interface IValidadorRes #E3F2FD {
    + ValidarRes(res : Res) : string
  }

  interface IValidadorPotrero #E3F2FD {
    + ValidarPotrero(potrero : Potrero) : string
  }

  interface IValidadorVacuna #E3F2FD {
    + ValidarVacuna(vacuna : Vacuna) : string
  }

  interface IValidadorVenta #E3F2FD {
    + ValidarVenta(venta : Venta) : string
  }

  ' Puertos de persistencia (DIP)
  interface IPersistenciaPotreros #FCE4EC
  interface IPersistenciaReses #FCE4EC
  interface IPersistenciaVacunas #FCE4EC
  interface IPersistenciaVentas #FCE4EC
  interface IPersistenciaUsuarios #FCE4EC
}

' ============================================================================
' PAQUETE: Validación, eventos y reglas
' ============================================================================
package "Validación, eventos y reglas" #FFFFFF {

  class ValidadorRes #FFFFFF {
    + ValidarRes(res : Res) : string
  }

  class ValidadorPotrero #FFFFFF {
    + ValidarPotrero(potrero : Potrero) : string
  }

  class ValidadorVacuna #FFFFFF {
    + ValidarVacuna(vacuna : Vacuna) : string
  }

  class ValidadorVenta #FFFFFF {
    + ValidarVenta(venta : Venta) : string
  }

  class PublisherPesoMin #FFFFFF
  class PublisherPesoVenta #FFFFFF
  class PublisherPotreroLleno #FFFFFF
  class PublisherPotreroMitad #FFFFFF
  class PublisherVacunaVencida #FFFFFF
  class PublisherVacunacionCompletada #FFFFFF

  abstract class ReglaRes #FFFFFF
  abstract class ReglaPotrero #FFFFFF
  abstract class ReglaVacuna #FFFFFF
  enum TipoVacuna #FFFFFF
}

