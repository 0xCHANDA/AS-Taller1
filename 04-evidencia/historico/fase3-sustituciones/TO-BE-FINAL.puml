@startuml
title Hacienda TO-BE final materializado - 2026-08-10
skinparam packageStyle rectangle

package "Dominio - Bib_Hacienda.Clases" {
  abstract class Producto
  abstract class Res
  class Ternero
  class Cebon
  class Novillo
  class Lacteo
  class Carne
  class Piel
  abstract class Vacuna
  class Bacteriana
  class Viva
  class Potrero
  class Venta
  class RegistroVenta
  class Hacienda
  class InventarioLacteos
  class InventarioCarnes
  class InventarioPieles
  class Usuario
  class Autenticacion
}

package "Contratos - Bib_Hacienda.Interfaces" {
  interface IInventarioVendible
  interface IInventario
  interface IVentaRes
  interface IVacunacion
  interface ICreacionVacuna
  interface IAutenticacion
  interface IValidadorRes
  interface IValidadorPotrero
  interface IValidadorVacuna
  interface IValidadorVenta
  interface IPersistenciaPotreros
  interface IPersistenciaReses
  interface IPersistenciaVacunas
  interface IPersistenciaVentas
  interface IPersistenciaUsuarios
}

package "Validación, eventos y reglas" {
  class ValidadorRes
  class ValidadorPotrero
  class ValidadorVacuna
  class ValidadorVenta
  class PublisherPesoMin
  class PublisherPesoVenta
  class PublisherPotreroLleno
  class PublisherPotreroMitad
  class PublisherVacunaVencida
  class PublisherVacunacionCompletada
  abstract class ReglaRes
  abstract class ReglaPotrero
  abstract class ReglaVacuna
  enum TipoVacuna
}

package "Aplicación MVC" {
  class PotreroService
  class ResService
  class VacunaService
  class VentaService
  class UsuarioService
  class PersistenciaService
  class ProductoPersistido
  class InterceptorAutenticacion
  class InterceptorValidarInformacion
  class AccountController
  class HomeController
  class PotreroController
  class ResController
  class UsuarioController
  class VacunaController
  class VentaController
  class ErrorViewModel
  class LoginViewModel
  class Program <<composition root>>
}

Producto <|-- Res
Producto <|-- Lacteo
Producto <|-- Carne
Producto <|-- Piel
Producto <|-- ProductoPersistido
Res <|-- Ternero
Res <|-- Cebon
Res <|-- Novillo
Vacuna <|-- Bacteriana
Vacuna <|-- Viva
IInventarioVendible <|-- IInventario
IInventario <|.. Potrero
IInventario <|.. InventarioLacteos
IInventario <|.. InventarioCarnes
IInventario <|.. InventarioPieles
Hacienda --> IInventarioVendible : vender<T>
Hacienda *-- RegistroVenta
RegistroVenta o-- Venta
Venta --> Producto
ValidadorRes ..|> IValidadorRes
ValidadorPotrero ..|> IValidadorPotrero
ValidadorVacuna ..|> IValidadorVacuna
ValidadorVenta ..|> IValidadorVenta
PersistenciaService ..|> IPersistenciaPotreros
PersistenciaService ..|> IPersistenciaReses
PersistenciaService ..|> IPersistenciaVacunas
PersistenciaService ..|> IPersistenciaVentas
PersistenciaService ..|> IPersistenciaUsuarios
PotreroService --> IPersistenciaPotreros
ResService --> IPersistenciaReses
VacunaService --> IPersistenciaVacunas
VentaService --> Hacienda
UsuarioService --> IPersistenciaUsuarios
Program --> PersistenciaService : compone
Program --> Hacienda : compone
@enduml
