    + {override} ValidarVenta(venta : Venta) : bool
  }
  class "ValidadorVacuna" as BH_ValidadorVacuna {
    + {override} ValidarVacuna(vacuna : Vacuna) : bool
    + {override} ValidarRes(res : Res) : bool
    + {override} ValidarPotrero(potrero : Potrero) : bool
    + {override} ValidarVenta(venta : Venta) : bool
  }
  class "ValidadorVenta" as BH_ValidadorVenta {
    + {override} ValidarVenta(venta : Venta) : bool
    + {override} ValidarRes(res : Res) : bool
    + {override} ValidarPotrero(potrero : Potrero) : bool
    + {override} ValidarVacuna(vacuna : Vacuna) : bool
  }
}

package "Bib_Hacienda.Reglas (Reglas estaticas)" {
  abstract class "ReglaPotrero" as BH_ReglaPotrero {
    + {static} {readOnly} max_reses_potrero : ushort = 150
  }
  abstract class "ReglaRes" as BH_ReglaRes {
    + {static} {readOnly} peso_min_ternero : ushort = 150
    + {static} {readOnly} peso_min_cebon : ushort = 290
    + {static} {readOnly} peso_min_novillo : ushort = 400
    + {static} {readOnly} peso_recom_venta_ternero : ushort = 250
    + {static} {readOnly} peso_recom_venta_cebon : ushort = 420
    + {static} {readOnly} peso_recom_venta_novillo : ushort = 550
    + {static} {readOnly} edad_max_ternero : byte = 12
    + {static} {readOnly} edad_max_cebon : byte = 48
  }
  abstract class "ReglaVacuna" as BH_ReglaVacuna {
    + {static} {readOnly} max_bac_ternero : byte = 3
    + {static} {readOnly} max_bac_cebon : byte = 1
    + {static} {readOnly} max_bac_novillo : byte = 2
    + {static} {readOnly} max_viv_ternero : byte = 1
    + {static} {readOnly} max_viv_cebon : byte = 4
    + {static} {readOnly} max_viv_novillo : byte = 2
    + {static} {readOnly} periodo_min_bac_aplic : byte = 2
    + {static} {readOnly} periodo_max_bac_aplic : byte = 4
  }
}

