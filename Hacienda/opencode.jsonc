{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.5",
  "default_agent": "solid-orchestrator",
  "share": "disabled",
  "snapshot": true,
  "formatter": true,
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000
  },
  "watcher": {
    "ignore": [
      "**/bin/**",
      "**/obj/**",
      "**/TestResults/**",
      "**/coverage/**",
      "**/.vs/**",
      "**/.idea/**"
    ]
  }
}
