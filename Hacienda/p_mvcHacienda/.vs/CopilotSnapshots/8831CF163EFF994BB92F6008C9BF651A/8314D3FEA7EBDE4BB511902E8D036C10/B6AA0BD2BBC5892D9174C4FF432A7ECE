    public class PersistenciaService
    {
        private readonly string _directorioArchivos = "Datos";
        private readonly Hacienda _hacienda;

        public PersistenciaService(Hacienda hacienda)
        {
            if (!Directory.Exists(_directorioArchivos))
            {
                Directory.CreateDirectory(_directorioArchivos);
            }

            _hacienda = hacienda;
        }

        #region Guardar Datos

        public bool GuardarPotreros(List<Potrero> potreros)
        {
            try
            {
                //Variables
                var validador = new ValidadorPotrero();
                var lineas = new List<string>();

                //Recorrer lista de potreros
                foreach (var potrero in potreros)
                {

                    // Validar que la informacion del potrero se pueda meter a la lista de potreros
                    if (!validador.ValidarPotrero(potrero))
                    return false;
                }

                //Agregar a la lista de lineas la informacion de los potreros
                foreach (var potrero in potreros)
                {
                    //Formato: Identificacion|Tipo_potrero
                    lineas.Add($"{potrero.Identificacion}|{potrero.Tipo_potrero}");
                }
                //Guardar en el archivo Potreros.txt
                File.WriteAllLines(Path.Combine(_directorioArchivos, "Potreros.txt"), lineas);
                return true; //cambiar el retunr para que retorne un string
            }

            catch (Exception ex)
            {
                throw new Exception($"Error al guardar potreros: {ex.Message}");
            }
        }

        public bool GuardarReses(List<Potrero> potreros)
        {
            try
            {
                //Variables
                var lineas = new List<string>();
                var validador = new ValidadorRes();
                foreach (var potrero in potreros)
                {
                    foreach (var res in potrero.L_reses)
                    {
                        if (!validador.ValidarRes(res))
                        return false;
                    }
                }

                
                foreach (var potrero in potreros)
                {
                    foreach (var res in potrero.L_reses)
                    {
                        string tipoRes = res.GetType().Name;
                        lineas.Add($"{potrero.Identificacion}|{res.Nombre}|{res.Peso}|{res.Edad}|{tipoRes}");
                    }
                }
                    File.WriteAllLines(Path.Combine(_directorioArchivos, "Reses.txt"), lineas);
                    return true;
            }

            catch (Exception ex)
            {
                    throw new Exception($"Error al guardar reses: {ex.Message}");
            }
        }

        public bool GuardarVentas(List<Venta> ventas)
        {
                try
                {
                    var validador = new ValidadorVenta();
                    foreach (var venta in ventas)
                    {
                        if (!validador.ValidarVenta(venta))
                        return false;
                    }

                    var lineas = new List<string>();
                    foreach (var venta in ventas)
                    {
                        string fecha = venta.Fecha.ToString("yyyy-MM-dd");
                        string tipoRes = venta.Res.GetType().Name;
                        lineas.Add($"{venta.Potrero.Identificacion}|{fecha}|{venta.Res.Nombre}|{venta.Res.Peso}|{venta.Res.Edad}|{tipoRes}|{venta.Monto}");
                    }
                        File.WriteAllLines(Path.Combine(_directorioArchivos, "Ventas.txt"), lineas);
                        return true;
                }

                catch (Exception ex)
                {
                    throw new Exception($"Error al guardar ventas: {ex.Message}");
                }
        }

        public string GuardarVacunas(List<Vacuna> vacunas)
        {
            try
            {
                string fechaVenc;
                string fechaAplic;
                string tipo;
                uint periodo;
                var validador = new ValidadorVacuna();

                foreach (var vacuna in vacunas)
                {
                    if (!validador.ValidarVacuna(vacuna))
                        return "Error al guardar en la base de datos";
                }

                var lineas = new List<string>();
                foreach (var vacuna in vacunas)
                {
                    fechaVenc = vacuna.Fecha_vencimiento.ToString("yyyy-MM-dd");
                    fechaAplic = vacuna.Fecha_aplicacion.ToString("yyyy-MM-dd");
                    tipo = vacuna.GetType().Name;
                    periodo = vacuna is Bacteriana ? ((Bacteriana)vacuna).Periodo_aplicacion : 0;
                    lineas.Add($"{vacuna.Nombre}|{vacuna.Lote}|{fechaVenc}|{fechaAplic}|{tipo}|{periodo}");
                }

                File.WriteAllLines(Path.Combine(_directorioArchivos, "Vacunas.txt"), lineas);
                return "Guradado Exitosamente";
            }
            
            catch (Exception ex)
            {
                throw new Exception($"Error al guardar vacunas: {ex.Message}");
            }
        }

        public bool GuardarVacunasAplicadas(List<Potrero> potreros)
        {
            try
            {
                var validadorRes = new ValidadorRes();
                foreach (var potrero in potreros)
                {
                    foreach (var res in potrero.L_reses)
                    {
                        if (!validadorRes.ValidarRes(res))
                        return false;
                    }
                }

                var lineas = new List<string>();
                foreach (var potrero in potreros)
                {
                    foreach (var res in potrero.L_reses)
                    {
                        foreach (var vacuna in res.L_vacunas_aplicadas)
                        {
                            string fechaVenc = vacuna.Fecha_vencimiento.ToString("yyyy-MM-dd");
                            string fechaAplic = vacuna.Fecha_aplicacion.ToString("yyyy-MM-dd");
                            string tipo = vacuna.GetType().Name;
                            uint periodo = vacuna is Bacteriana ? ((Bacteriana)vacuna).Periodo_aplicacion : 0;
                            lineas.Add($"{potrero.Identificacion}|{res.Nombre}|{vacuna.Nombre}|{vacuna.Lote}|{fechaVenc}|{fechaAplic}|{tipo}|{periodo}");
                        }
                    }
                }
                File.WriteAllLines(Path.Combine(_directorioArchivos, "VacunasAplicadas.txt"), lineas);
                return true;
            }

            catch (Exception ex)
            {
                throw new Exception($"Error al guardar vacunas aplicadas: {ex.Message}");
            }
        }

        public bool GuardarUsuarios(List<Usuario> usuarios)
