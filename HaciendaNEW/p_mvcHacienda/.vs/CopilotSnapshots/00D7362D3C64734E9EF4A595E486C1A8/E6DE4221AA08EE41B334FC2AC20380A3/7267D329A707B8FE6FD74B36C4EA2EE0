using Bib_Hacienda.Clases;
using static Bib_Hacienda.Clases.Viva;

namespace p_mvcHacienda.Servicios
{
    public class VacunaService
    {
     // Atributos
        private readonly Hacienda _hacienda;
        private readonly PersistenciaService _persistencia;
  
        // Constructor
 public VacunaService(Hacienda hacienda, PersistenciaService persistencia)
  {
  _hacienda = hacienda;
 _persistencia = persistencia;
    }

#region Métodos Sobrecargados para Crear Vacunas

        // Sobrecarga 1: Crear vacuna bacteriana básica
   public bool CrearVacuna(string nombre, string lote, DateTime fechaVencimiento)
      {
   return CrearVacunaBacteriana(nombre, lote, fechaVencimiento, DateTime.Now, 4);
        }

        // Sobrecarga 2: Crear vacuna con tipo específico
        public bool CrearVacuna(string nombre, string lote, DateTime fechaVencimiento, string tipo)
        {
       if (tipo.ToLower() == "bacteriana")
   {
     return CrearVacunaBacteriana(nombre, lote, fechaVencimiento, DateTime.Now, 4);
    }
            else
 {
  return CrearVacunaViva(nombre, lote, fechaVencimiento, DateTime.Now, enum_l_atenuaciones.Atenuacion10);
     }
        }

        // Sobrecarga 3: Crear vacuna bacteriana completa
        public bool CrearVacuna(string nombre, string lote, DateTime fechaVencimiento, DateTime fechaAplicacion, uint periodoAplicacion)
     {
     return CrearVacunaBacteriana(nombre, lote, fechaVencimiento, fechaAplicacion, periodoAplicacion);
      }

        // Sobrecarga 4: Crear vacuna viva completa
  public bool CrearVacuna(string nombre, string lote, DateTime fechaVencimiento, DateTime fechaAplicacion, enum_l_atenuaciones atenuacion)
    {
        return CrearVacunaViva(nombre, lote, fechaVencimiento, fechaAplicacion, atenuacion);
        }

      // Sobrecarga 5: Crear vacunas predefinidas del sistema
   public bool CrearVacunasPredefinidas()
        {
  try
  {
   var fechaVencimiento = DateTime.Now.AddYears(1);
   var fechaAplicacion = DateTime.Now;

   // Vacunas bacterianas predefinidas
  CrearVacunaBacteriana("Carbón Sintomático", "CARB001", fechaVencimiento, fechaAplicacion, 6);
         CrearVacunaBacteriana("Neumonía Bacteriana", "NEUM001", fechaVencimiento, fechaAplicacion, 4);
   CrearVacunaBacteriana("Clostridiosis", "CLOS001", fechaVencimiento, fechaAplicacion, 8);
          CrearVacunaBacteriana("Mastitis", "MAST001", fechaVencimiento, fechaAplicacion, 3);

 // Vacunas vivas predefinidas (usando valores válidos de enum_l_atenuaciones)
         CrearVacunaViva("Fiebre Aftosa", "AFTO001", fechaVencimiento, fechaAplicacion, enum_l_atenuaciones.Atenuacion10);
             CrearVacunaViva("IBR/DVB", "IBR001", fechaVencimiento, fechaAplicacion, enum_l_atenuaciones.Atenuacion10);
         CrearVacunaViva("Parainfluenza", "PARA001", fechaVencimiento, fechaAplicacion, enum_l_atenuaciones.Atenuacion20);
    CrearVacunaViva("Rinotraqueítis", "RINO001", fechaVencimiento, fechaAplicacion, enum_l_atenuaciones.Atenuacion20);

   return true;
    }
  catch (Exception ex)
{
    throw new Exception($"Error al crear vacunas predefinidas: {ex.Message}");
     }
        }

        #endregion

      #region Métodos Base para Crear Vacunas

        // Crear vacuna bacteriana
        public bool CrearVacunaBacteriana(string nombre, string lote, DateTime fechaVencimiento, DateTime fechaAplicacion, uint periodoAplicacion)
   {
         try
{
    // Validar que no exista una vacuna con el mismo lote
if (_hacienda.L_vacunas.Any(v => v.Lote == lote))
       {
   throw new InvalidOperationException($"Ya existe una vacuna con el lote '{lote}'");
       }

        // Validar fechas
     if (fechaVencimiento <= fechaAplicacion)
 {
         throw new ArgumentException("La fecha de vencimiento debe ser posterior a la fecha de aplicación");
   }

    var vacuna = new Bacteriana(nombre, lote, fechaVencimiento, fechaAplicacion, periodoAplicacion);
    _hacienda.L_vacunas.Add(vacuna);
       _persistencia.GuardarVacunas(_hacienda.L_vacunas);
return true;
        }
            catch (Exception ex)
 {
   throw new Exception($"Error al crear vacuna bacteriana: {ex.Message}");
   }
        }

 // Crear vacuna viva
public bool CrearVacunaViva(string nombre, string lote, DateTime fechaVencimiento, DateTime fechaAplicacion, enum_l_atenuaciones atenuacion)
        {
     try
       {
        // Validar que no exista una vacuna con el mismo lote
  if (_hacienda.L_vacunas.Any(v => v.Lote == lote))
        {
       throw new InvalidOperationException($"Ya existe una vacuna con el lote '{lote}'");
}

        // Validar fechas
    if (fechaVencimiento <= fechaAplicacion)
     {
  throw new ArgumentException("La fecha de vencimiento debe ser posterior a la fecha de aplicación");
         }

  var vacuna = new Viva(nombre, lote, fechaVencimiento, fechaAplicacion, atenuacion);
  _hacienda.L_vacunas.Add(vacuna);
       _persistencia.GuardarVacunas(_hacienda.L_vacunas);
        return true;
    }
    catch (Exception ex)
            {
     throw new Exception($"Error al crear vacuna viva: {ex.Message}");
  }
        }

        #endregion

    #region Métodos Existentes

        // Aplicar vacuna a una res
   public bool AplicarVacuna(string potreroId, string nombreRes, string loteVacuna)
        {
  try
  {
       // Buscar la vacuna por su lote
  var vacuna = _hacienda.L_vacunas.FirstOrDefault(v => v.Lote == loteVacuna);

       if (vacuna == null)
       {
  throw new InvalidOperationException($"No se encontró una vacuna con el lote '{loteVacuna}'");
          }

      // Verificar si la vacuna está vencida
             if (vacuna.Fecha_vencimiento < DateTime.Now)
  {
           throw new InvalidOperationException($"La vacuna '{vacuna.Nombre}' está vencida");
      }

  // La firma correcta es: aplicar_vacuna(Vacuna vacuna, string nombre, string id_potrero)
             string resultado = _hacienda.aplicar_vacuna(vacuna, nombreRes, potreroId);
    _persistencia.GuardarPotreros(_hacienda.L_potreros);
         _persistencia.GuardarReses(_hacienda.L_potreros);
    _persistencia.GuardarVacunasAplicadas(_hacienda.L_potreros);
           _persistencia.GuardarVacunas(_hacienda.L_vacunas);
     return true;
  }
      catch (Exception ex)
     {
  throw new Exception($"Error al aplicar vacuna: {ex.Message}");
    }
        }

        // Obtener todas las vacunas disponibles
        public List<Vacuna> ObtenerVacunasDisponibles()
 {
// Ordenar por nombre antes de retornar
   return _hacienda.L_vacunas.OrderBy(v => v.Nombre).ToList();
    }

   // Obtener vacunas aplicadas a una res
        public List<Vacuna> ObtenerVacunasAplicadas(string potreroId, string nombreRes)
   {
      try
            {
  // Buscar el potrero por su identificación
       var potrero = _hacienda.buscar_potrero(potreroId);
              var res = potrero.buscar_res(nombreRes);
  return res.L_vacunas_aplicadas;
       }
       catch
 {
   return new List<Vacuna>();
      }
     }

   // Obtener estadísticas de vacunas
        public Dictionary<string, object> ObtenerEstadisticas()
  {
  var vacunas = _hacienda.L_vacunas;

   // Calcular estadísticas
      return new Dictionary<string, object>
  {
    { "TotalVacunas", vacunas.Count },
       { "Bacterianas", vacunas.Count(v => v is Bacteriana) },
         { "Vivas", vacunas.Count(v => v is Viva) },
  { "Vencidas", vacunas.Count(v => v.Fecha_vencimiento < DateTime.Now) },
 { "Vigentes", vacunas.Count(v => v.Fecha_vencimiento >= DateTime.Now) }
};
        }

        #endregion
    }
}
