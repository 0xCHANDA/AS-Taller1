using Bib_Hacienda.Clases;
using static Bib_Hacienda.Clases.Viva;

namespace p_mvcHacienda.Servicios
{
    public class VacunaService
    {
        // Atributos
        private readonly Hacienda _hacienda;
        private readonly PersistenciaService _persistencia;
      
  // Constructor
    public VacunaService(Hacienda hacienda, PersistenciaService persistencia)
        {
    _hacienda = hacienda;
       _persistencia = persistencia;
  }

        // Crear vacuna viva o bacteriana
public string CrearVacuna(string nombre, string lote, DateTime fechaVencimiento, DateTime fechaAplicacion, uint? periodoAplicacion, enum_l_atenuaciones? atenuacion)
      {
  try
            {
   // Bacteriana: requiere periodo y NO atenuación
  if (periodoAplicacion.HasValue && !atenuacion.HasValue)
{
      _hacienda.crear_vacuna(nombre, lote, fechaVencimiento, fechaAplicacion, periodoAplicacion.Value);
     }
           // Viva: requiere atenuación y NO periodo
   else if (!periodoAplicacion.HasValue && atenuacion.HasValue)
  {
_hacienda.crear_vacuna(nombre, lote, fechaVencimiento, fechaAplicacion, atenuacion.Value);
          }
else
   {
          return "Error: parámetros inválidos para crear la vacuna";
    }

       _persistencia.GuardarVacunas(_hacienda.L_vacunas);

        // Verificar si está vencida al momento de crearla
       if (fechaVencimiento < DateTime.Now)
    {
        return $"⚠ Vacuna '{nombre}' creada pero está VENCIDA (venció el {fechaVencimiento:dd/MM/yyyy})";
       }

       // Mensaje único y claro
      return $"✓ Vacuna '{nombre}' (Lote: {lote}) creada exitosamente";
   }
     catch (Exception ex)
          {
           return $"Error: {ex.Message}";
     }
        }

 // Aplicar vacuna a una res
  public string AplicarVacuna(string potreroId, string nombreRes, string loteVacuna)
 {
  try
        {
   // Asegurar catálogo cargado
          if (_hacienda.L_vacunas.Count == 0)
      {
   var cargadas = _persistencia.CargarVacunas();
      foreach (var v in cargadas) _hacienda.L_vacunas.Add(v);
       }

         // Buscar la vacuna por su lote
    var vacuna = _hacienda.L_vacunas.FirstOrDefault(v => v.Lote == loteVacuna);
if (vacuna == null)
         {
 throw new Exception($"No se encontró una vacuna con el lote '{loteVacuna}'");
 }

  // VERIFICAR SI LA VACUNA ESTÁ VENCIDA
    if (vacuna.Fecha_vencimiento < DateTime.Now)
        {
          return $"⚠ ERROR: La vacuna '{vacuna.Nombre}' está VENCIDA (venció el {vacuna.Fecha_vencimiento:dd/MM/yyyy}). No se puede aplicar.";
   }

 // Aplicar la vacuna desde la hacienda (dispara eventos del dominio)
           string resultadoDominio = _hacienda.aplicar_vacuna(vacuna, nombreRes, potreroId);

              // Remover del inventario disponible si aún existe
     var existente = _hacienda.L_vacunas.FirstOrDefault(v => v.Lote == loteVacuna);
    if (existente != null)
    {
         _hacienda.L_vacunas.Remove(existente);
      }

     // Persistir cambios (guardar silenciosamente)
  _persistencia.GuardarVacunasAplicadas(_hacienda.L_potreros);
        _persistencia.GuardarVacunas(_hacienda.L_vacunas);
 _persistencia.GuardarPotreros(_hacienda.L_potreros);
      _persistencia.GuardarReses(_hacienda.L_potreros);

         // Contar vacunas aplicadas
 var potrero = _hacienda.buscar_potrero(potreroId);
     var res = potrero?.buscar_res(nombreRes);
   int bacterianas = res?.L_vacunas_aplicadas.Count(v => v is Bacteriana) ?? 0;
    int vivas = res?.L_vacunas_aplicadas.Count(v => v is Viva) ?? 0;

   // Limpiar y consolidar mensaje
              string mensajeFinal = LimpiarMensajeDuplicado(resultadoDominio, bacterianas, vivas);
              
  return mensajeFinal;
            }
            catch (Exception ex)
         {
     return $"Error: {ex.Message}";
 }
 }

        // Método auxiliar para limpiar mensajes duplicados
        private string LimpiarMensajeDuplicado(string mensajeOriginal, int bacterianas, int vivas)
        {
       // El mensaje original de la biblioteca viene con múltiples partes
            // Ejemplo: "Vacuna aplicada correctamente a la res pepa. [Evento] La res 'pepa' aún no ha completado su esquema de vacunación. Bacterianas: 0, Vivas: 1."
 
    // Dividir por punto y filtrar duplicados
   var partes = mensajeOriginal
           .Split(new[] { ". " }, StringSplitOptions.RemoveEmptyEntries)
       .Select(p => p.Trim())
          .Where(p => !string.IsNullOrWhiteSpace(p))
          .ToList();

     // Eliminar duplicados manteniendo el orden
     var partesUnicas = new List<string>();
      var vistos = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    foreach (var parte in partes)
            {
           // Normalizar para comparación (ignorar variaciones menores)
     string normalizado = parte.ToLower()
        .Replace("datos válidos", "")
        .Replace("guardado exitoso en bd", "")
        .Trim();

     if (!string.IsNullOrWhiteSpace(normalizado) && !vistos.Contains(normalizado))
    {
        vistos.Add(normalizado);
              partesUnicas.Add(parte);
      }
       }

       // Reconstruir mensaje sin las partes de persistencia redundantes
    string mensajeLimpio = string.Join(". ", partesUnicas);

  // Añadir información de guardado una sola vez al final
  if (!mensajeLimpio.Contains("Guardado") && !mensajeLimpio.Contains("BD"))
         {
      mensajeLimpio += ". Datos válidos. Guardado exitoso en BD";
      }

      return mensajeLimpio;
   }

        // Obtener todas las vacunas disponibles (solo vigentes)
    public List<Vacuna> ObtenerVacunasDisponibles()
        {
      // Lazy-load desde archivo si el catálogo está vacío
    if (_hacienda.L_vacunas.Count == 0)
     {
  var cargadas = _persistencia.CargarVacunas();
  foreach (var v in cargadas) _hacienda.L_vacunas.Add(v);
   }
       
     // Retornar solo las NO vencidas
       return _hacienda.L_vacunas
     .Where(v => v.Fecha_vencimiento >= DateTime.Now)
            .OrderBy(v => v.Nombre)
  .ToList();
        }

     // Obtener vacunas aplicadas a una res
        public List<Vacuna> ObtenerVacunasAplicadas(string potreroId, string nombreRes)
{
   try
            {
            var potrero = _hacienda.buscar_potrero(potreroId);
        var res = potrero.buscar_res(nombreRes);
 return res.L_vacunas_aplicadas;
    }
  catch
            {
      return new List<Vacuna>();
        }
        }

        // Obtener estadísticas de vacunas
    public Dictionary<string, object> ObtenerEstadisticas()
        {
        // Asegurar catálogo cargado
        if (_hacienda.L_vacunas.Count == 0)
 {
  var cargadas = _persistencia.CargarVacunas();
        foreach (var v in cargadas) _hacienda.L_vacunas.Add(v);
         }

  var vacunas = _hacienda.L_vacunas;
        return new Dictionary<string, object>
      {
 { "TotalVacunas", vacunas.Count },
  { "Bacterianas", vacunas.Count(v => v is Bacteriana) },
       { "Vivas", vacunas.Count(v => v is Viva) },
          { "Vencidas", vacunas.Count(v => v.Fecha_vencimiento < DateTime.Now) },
      { "Vigentes", vacunas.Count(v => v.Fecha_vencimiento >= DateTime.Now) }
       };
      }
    }
}
