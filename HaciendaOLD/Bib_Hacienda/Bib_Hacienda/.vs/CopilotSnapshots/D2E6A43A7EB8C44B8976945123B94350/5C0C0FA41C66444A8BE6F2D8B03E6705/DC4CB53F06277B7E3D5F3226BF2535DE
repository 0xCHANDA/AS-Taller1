using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Bib_Hacienda.Clases.Validaciones
{
    /// <summary>
    /// Clase especializada en validar objetos de tipo Vacuna
    /// Verifica que los datos de la vacuna sean correctos antes de guardar en BD
    /// </summary>
    public class ValidadorVacuna : Validacion
    {
        /// <summary>
        /// Valida que una vacuna tenga datos correctos para ser guardada
        /// Verifica: nombre no vacío, lote no vacío, fecha de vencimiento válida
        /// </summary>
        /// <param name="vacuna">Vacuna a validar</param>
        /// <returns>True si es válida, False en caso contrario</returns>
        public override bool ValidarVacuna(Vacuna vacuna)
        {
            try
            {
                // Validar que la vacuna no sea nula
                if (!ValidarNoNulo(vacuna))
                {
                    MostrarMensaje("Vacuna [NULL]", false);
                    return false;
                }

                // Validar nombre
                if (!ValidarString(vacuna.Nombre))
                {
                    MostrarMensaje("Vacuna [Nombre vacío]", false);
                    return false;
                }

                // Validar lote
                if (!ValidarString(vacuna.Lote))
                {
                    MostrarMensaje($"Vacuna '{vacuna.Nombre}' [Lote vacío]", false);
                    return false;
                }

                // Validar fecha de vencimiento (no puede ser anterior a fecha de aplicación)
                if (vacuna.Fecha_vencimiento < vacuna.Fecha_aplicacion)
                {
                    MostrarMensaje($"Vacuna '{vacuna.Nombre}' [Fecha de vencimiento anterior a fecha de aplicación]", false);
                    return false;
                }

                // Validar que la vacuna no esté vencida hace mucho tiempo (más de 1 año)
                if (vacuna.Fecha_vencimiento < DateTime.Now.AddYears(-1))
                {
                    MostrarMensaje($"Vacuna '{vacuna.Nombre}' [Vencida hace más de 1 año]", false);
                    return false;
                }

                // Si todas las validaciones pasan
                string estado = vacuna.Fecha_vencimiento > DateTime.Now ? "Vigente" : "Vencida";
                MostrarMensaje($"Vacuna '{vacuna.Nombre}' del lote '{vacuna.Lote}' ({estado})", true);
                return true;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Validación] ✗ Error al validar Vacuna: {ex.Message}");
                return false;
            }
        }

        /// <summary>
        /// No implementado. Use la clase ValidadorRes
        /// </summary>
        public override bool ValidarRes(Res res)
        {
            throw new NotImplementedException("Para validar Res, use la clase ValidadorRes");
        }

        /// <summary>
        /// No implementado. Use la clase ValidadorPotrero
        /// </summary>
        public override bool ValidarPotrero(Potrero potrero)
        {
            throw new NotImplementedException("Para validar Potrero, use la clase ValidadorPotrero");
        }

        /// <summary>
        /// No implementado. Use la clase ValidadorVenta
        /// </summary>
        public override bool ValidarVenta(Venta venta)
        {
            throw new NotImplementedException("Para validar Venta, use la clase ValidadorVenta");
        }
    }
}
