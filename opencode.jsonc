{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "share": "disabled",
  "snapshot": true,
  "formatter": true,
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000
  },
  "watcher": {
    "ignore": [
      "**/bin/**",
      "**/obj/**",
      "**/TestResults/**",
      "**/coverage/**",
      "**/.vs/**",
      "**/.idea/**"
    ]
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/secrets.json": "deny",
      "**/appsettings.*.json": "ask"
    },
    "edit": "ask",
    "bash": {
      "*": "ask",
      "dotnet --info*": "allow",
      "dotnet sln * list*": "allow",
      "dotnet build*": "allow",
      "dotnet test*": "allow",
      "dotnet format*--verify-no-changes*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch --show-current*": "allow",
      "rg *": "allow",
      "find *": "allow",
      "ls *": "allow",
      "rm *": "deny",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny"
    },
    "external_directory": "deny",
    "webfetch": "ask",
    "websearch": "ask",
    "doom_loop": "ask",
    "skill": "allow"
  },
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  }
}
