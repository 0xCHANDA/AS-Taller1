{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "opencode-go/deepseek-v4-flash",
  "default_agent": "solid-orchestrator",
  "share": "disabled",
  "snapshot": true,
  "formatter": true,
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000
  },
  "watcher": {
    "ignore": [
      "**/bin/**",
      "**/obj/**",
      "**/TestResults/**",
      "**/coverage/**",
      "**/.vs/**",
      "**/.idea/**"
    ]
  },
  "permission": {
    "*": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/secrets.json": "deny",
      "**/appsettings.*.json": "deny"
    },
    "edit": "deny",
    "bash": {
      "*": "deny"
    },
    "task": "deny",
    "question": "deny",
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "doom_loop": "deny",
    "skill": "allow"
  },
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  }
}
